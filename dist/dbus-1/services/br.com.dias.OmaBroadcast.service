# D-Bus activation of oma-broadcastd: a call addressed to
# br.com.dias.OmaBroadcast starts the systemd user service (never the binary
# directly). Installed to /usr/share/dbus-1/services/ by the package, or to
# ~/.local/share/dbus-1/services/ for a user install (see
# dist/systemd/oma-broadcastd.service).
[D-BUS Service]
Name=br.com.dias.OmaBroadcast
Exec=/bin/false
SystemdService=oma-broadcastd.service
