# D-Bus activation of the audio worker: a call addressed to
# br.com.dias.OmarchyBroadcast.AudioWorker starts the systemd user service
# (never the binary directly). The interface is internal to
# omarchy-broadcastd and unstable. Installed to /usr/share/dbus-1/services/ by
# the package, or to ~/.local/share/dbus-1/services/ for a user install (see
# dist/systemd/omarchy-broadcast-audiod.service).
[D-BUS Service]
Name=br.com.dias.OmarchyBroadcast.AudioWorker
Exec=/bin/false
SystemdService=omarchy-broadcast-audiod.service
